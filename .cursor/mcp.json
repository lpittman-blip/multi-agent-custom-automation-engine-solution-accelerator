{
  "mcpServers": {
    "macae": {
      "url": "http://localhost:9000/mcp",
      "transport": "streamable-http"
    },
    "macae-hr": {
      "url": "http://localhost:9000/hr/mcp",
      "transport": "streamable-http"
    },
    "macae-tech-support": {
      "url": "http://localhost:9000/tech_support/mcp",
      "transport": "streamable-http"
    },
    "macae-marketing": {
      "url": "http://localhost:9000/marketing/mcp",
      "transport": "streamable-http"
    },
    "macae-product": {
      "url": "http://localhost:9000/product/mcp",
      "transport": "streamable-http"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    }
  }
}
